# Copy to .env; setup script generates development-only random values.
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_PASSWORD=
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Local fallback only; Compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite:///./sentinel.db
# API_INTERNAL_URL is set by Compose at frontend build time.
